# ---------- Core ----------
DATABASE_URL=postgres://brain:brain@localhost:5432/brain
# Origin of the deployment, no path. Used to build absolute media and share URLs.
APP_URL=http://localhost:3000
# Serve the app from a sub path of an existing domain, e.g. /brain for henriquerocha.art/brain.
# Empty = domain root. Changing it requires a rebuild; the parent site must rewrite <BASE_PATH>/* here.
BASE_PATH=
# Connections per process. Defaults to 3 on serverless and 10 elsewhere; raise only with a pooler.
DB_POOL_MAX=
# Protects /api/* for external agents. Leave empty to disable auth (local only).
BRAIN_API_KEY=

# ---------- Processing ----------
# "worker": jobs are queued in Postgres (pg-boss) and processed by `npm run worker`.
# "inline": the API processes the reference in the background of the same process (dev / single box).
PROCESSING_MODE=inline

# ---------- Storage ----------
# "local" writes to ./storage and serves via /api/media. "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects (e.g. R2 public bucket or CloudFront). Falls back to presigned-less path via /api/media.
S3_PUBLIC_URL=

# ---------- AI (model agnostic) ----------
# Provider for reasoning + vision (synthesis, why-interesting, think mode, ask): anthropic | openai | gemini | mock (keyless, for demos)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Provider for embeddings: openai | gemini | voyage | mock   (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column width. Fixed at first migration; change requires re-embedding.
EMBEDDING_DIMENSIONS=1536
# Provider for speech-to-text: openai | gemini | none
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# ---------- Connectors ----------
# Instagram oEmbed needs a Meta app token; without it we fall back to OpenGraph metadata.
INSTAGRAM_OEMBED_TOKEN=
# YouTube Data API key (optional, richer metadata). Without it we use public oEmbed.
YOUTUBE_API_KEY=
# Media retrieval from social platforms. "none" stores URL + public metadata + thumbnail only.
# "yt-dlp" downloads media with a local yt-dlp binary. Enable only where platform terms allow it.
MEDIA_FETCHER=none
YT_DLP_PATH=yt-dlp
# ffmpeg/ffprobe for video frames and audio. Leave empty to use a system binary or the bundled ffmpeg-static (works on Vercel).
FFMPEG_PATH=
FFPROBE_PATH=
