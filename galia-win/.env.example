# --- Pix (os três, ou a página mostra "chave ainda não configurada") ---
# Telefone sempre com +55 e DDD. CPF, e-mail ou chave aleatória vão como estão cadastrados.
PIX_KEY=+5511999999999
# Nome de quem recebe, até 25 caracteres. Alguns bancos mostram antes de confirmar.
PIX_NAME=
# Cidade de quem recebe, até 15 caracteres. Campo obrigatório do QR Code Pix.
PIX_CITY=

# --- Painel ---
# Pelo menos 10 caracteres. Trocar a senha desloga todos os aparelhos.
ADMIN_PASSWORD=

# --- Banco ---
# Postgres (Neon, Supabase, Vercel Postgres). Obrigatório na Vercel.
# Sem ele, o app usa um Postgres embutido gravado em DATA_DIR (bom para rodar local ou num servidor com disco).
DATABASE_URL=
# DATA_DIR=.data/db

# --- E-mail (SMTP). Sem isso dá para aprovar e mandar o link da entrada pelo WhatsApp. ---
# Gmail: smtp.gmail.com, porta 465, seu e-mail e uma "senha de app" (precisa de verificação em duas etapas).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="Galia Win <seuemail@gmail.com>"

# Endereço público do site, usado nos links do e-mail. Sem ele, usa o endereço por onde o painel foi aberto.
# SITE_URL=https://galiawin.com.br
